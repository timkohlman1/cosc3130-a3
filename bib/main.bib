@article{Ji2026LDPG,
  author    = {Lixia Ji and Yifan Wang and Hanliang Ren and Han Zhang},
  title     = {A local dynamic propagation graph-based method for multi-modal fake news detection},
  journal   = {Journal of Intelligent Information Systems},
  year      = {2026},
  date      = {2026-02-21},
  abstract  = {The rapid proliferation of fake news on social media poses a substantial threat to public opinion and information credibility. This study aims to improve multi-modal fake news detection by jointly modeling dynamic information propagation and content-interaction consistency, especially with incomplete early observations. Although both multi-modal content features and propagation structures play a pivotal role in fake news detection, existing studies often concentrate on static semantics or overlook the dynamic evolution of information diffusion, thereby failing to comprehensively capture the fine-grained characteristics of rumor propagation. To bridge this gap, we propose a Local Dynamic Propagation Graph (LDPG) method for multi-modal fake news detection. Specifically, a multi-head attention mechanism is employed to jointly encode and fuse textual and visual features, yielding unified multi-modal representations. Subsequently, constructing local dynamic propagation graph to model the fine-grained evolution of user interactions across different temporal windows. A graph neural network is then utilized to capture semantic relationships within each window, while a time-aware modality alignment loss is introduced to enforce consistency between static multi-modal content and dynamic propagation representations. Finally, a classifier integrates multi-modal and dynamic graph features to achieve robust fake news detection. Extensive experiments on three benchmark datasets—PHEME, PolitiFact, and GossipCop—show that LDPG significantly outperforms state-of-the-art methods. It also demonstrates stronger robustness and timeliness in early detection scenarios.}
}